{
  "name": "devcode-quiz",
  "displayName": "DEV CODE - Verificação de Entendimento",
  "description": "Antes de executar o código, o aluno precisa responder corretamente uma pergunta sobre o próprio código.",
  "version": "1.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:devcode.start",
    "onNotebook:jupyter-notebook",
    "onCustomEditor:devcode.prototype",
    "onCustomEditor:devcode.test",
    "onView:devcode.db.explorer",
    "onLanguage:sql"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "devcode.run",
        "title": "Executar (responder pergunta)",
        "category": "DEV CODE",
        "icon": "$(play)"
      },
      {
        "command": "devcode.newProject",
        "title": "Novo Projeto…",
        "category": "DEV CODE",
        "icon": "$(new-folder)"
      },
      {
        "command": "devcode.newPythonProject",
        "title": "Novo Projeto Python…",
        "category": "DEV CODE"
      },
      {
        "command": "devcode.newHtmlProject",
        "title": "Novo Projeto HTML…",
        "category": "DEV CODE"
      },
      {
        "command": "devcode.liveServer.start",
        "title": "Abrir com Live Server (Go Live)",
        "category": "DEV CODE",
        "icon": "$(globe)"
      },
      {
        "command": "devcode.liveServer.stop",
        "title": "Parar Live Server",
        "category": "DEV CODE"
      },
      {
        "command": "devcode.git.commitPush",
        "title": "Enviar para o GitHub (commit + push)",
        "category": "DEV CODE",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "devcode.git.pull",
        "title": "Atualizar do GitHub (pull)",
        "category": "DEV CODE",
        "icon": "$(cloud-download)"
      },
      {
        "command": "devcode.git.connect",
        "title": "Conectar projeto ao GitHub",
        "category": "DEV CODE",
        "icon": "$(github)"
      },
      {
        "command": "devcode.github.login",
        "title": "Entrar no GitHub",
        "category": "DEV CODE",
        "icon": "$(github)"
      },
      {
        "command": "devcode.github.logout",
        "title": "Sair do GitHub",
        "category": "DEV CODE"
      },
      {
        "command": "devcode.startPage",
        "title": "Tela Inicial",
        "category": "DEV CODE",
        "icon": "$(home)"
      },
      {
        "command": "devcode.notebook.restart",
        "title": "Reiniciar ambiente de execução",
        "category": "DEV CODE",
        "icon": "$(debug-restart)"
      },
      {
        "command": "devcode.newColabProject",
        "title": "Novo Projeto Colab…",
        "category": "DEV CODE"
      },
      {
        "command": "devcode.checkForUpdates",
        "title": "Verificar atualizações",
        "category": "DEV CODE"
      },
      {
        "command": "devcode.prototype.newScreen",
        "title": "Nova Tela do Protótipo…",
        "category": "DEV CODE",
        "icon": "$(add)"
      },
      {
        "command": "devcode.newPrototypeProject",
        "title": "Novo Protótipo…",
        "category": "DEV CODE"
      },
      {
        "command": "devcode.android.setup",
        "title": "Instalar Emulador Android",
        "category": "DEV CODE",
        "icon": "$(device-mobile)"
      },
      {
        "command": "devcode.android.start",
        "title": "Ligar Emulador Android",
        "category": "DEV CODE",
        "icon": "$(device-mobile)"
      },
      {
        "command": "devcode.db.add",
        "title": "Nova Conexão",
        "category": "Banco de Dados",
        "icon": "$(add)"
      },
      {
        "command": "devcode.db.refresh",
        "title": "Atualizar",
        "category": "Banco de Dados",
        "icon": "$(refresh)"
      },
      {
        "command": "devcode.db.newSql",
        "title": "Novo Editor SQL",
        "category": "Banco de Dados",
        "icon": "$(new-file)"
      },
      {
        "command": "devcode.db.runStatement",
        "title": "Executar Instrução (Ctrl+Enter)",
        "category": "Banco de Dados",
        "icon": "$(play)"
      },
      {
        "command": "devcode.db.runAll",
        "title": "Executar Script Inteiro (Alt+X)",
        "category": "Banco de Dados",
        "icon": "$(run-all)"
      },
      {
        "command": "devcode.db.pickActive",
        "title": "Escolher Banco para o SQL",
        "category": "Banco de Dados",
        "icon": "$(database)"
      },
      {
        "command": "devcode.db.setActive",
        "title": "Usar Esta Conexão no SQL",
        "category": "Banco de Dados",
        "icon": "$(check)"
      },
      {
        "command": "devcode.db.disconnect",
        "title": "Desconectar",
        "category": "Banco de Dados",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "devcode.db.remove",
        "title": "Remover Conexão",
        "category": "Banco de Dados",
        "icon": "$(trash)"
      },
      {
        "command": "devcode.db.openTable",
        "title": "Ver Registros",
        "category": "Banco de Dados",
        "icon": "$(table)"
      },
      {
        "command": "devcode.db.tableInfo",
        "title": "Dicionário da Tabela",
        "category": "Banco de Dados",
        "icon": "$(info)"
      },
      {
        "command": "devcode.db.selectTable",
        "title": "Gerar SELECT",
        "category": "Banco de Dados",
        "icon": "$(code)"
      },
      {
        "command": "devcode.db.showSource",
        "title": "Ver Código (DDL)",
        "category": "Banco de Dados",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "devcode.run",
          "group": "navigation@0",
          "when": "editorLangId != sql && activeCustomEditorId != devcode.prototype"
        }
      ],
      "editor/title": [
        {
          "command": "devcode.run",
          "group": "navigation@0",
          "when": "editorLangId != sql && activeCustomEditorId != devcode.prototype"
        },
        {
          "command": "devcode.db.runStatement",
          "when": "editorLangId == sql",
          "group": "navigation@0"
        },
        {
          "command": "devcode.db.runAll",
          "when": "editorLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "devcode.db.pickActive",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        }
      ],
      "file/newFile": [
        {
          "command": "devcode.newProject",
          "group": "devcode"
        }
      ],
      "editor/context": [
        {
          "command": "devcode.liveServer.start",
          "when": "resourceLangId == html",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "devcode.git.commitPush",
          "group": "navigation@0"
        },
        {
          "command": "devcode.git.pull",
          "group": "navigation@1"
        },
        {
          "command": "devcode.github.login",
          "group": "navigation@2"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "devcode.notebook.restart",
          "group": "navigation/execute@10",
          "when": "notebookType == jupyter-notebook"
        }
      ],
      "explorer/context": [
        {
          "command": "devcode.prototype.newScreen",
          "when": "config.devcode.projectType == prototipo",
          "group": "navigation@0"
        }
      ],
      "view/title": [
        {
          "command": "devcode.prototype.newScreen",
          "when": "view == workbench.explorer.fileView && config.devcode.projectType == prototipo",
          "group": "navigation@0"
        },
        {
          "command": "devcode.db.add",
          "when": "view == devcode.db.explorer",
          "group": "navigation@0"
        },
        {
          "command": "devcode.db.newSql",
          "when": "view == devcode.db.explorer",
          "group": "navigation@1"
        },
        {
          "command": "devcode.db.refresh",
          "when": "view == devcode.db.explorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "devcode.db.newSql",
          "when": "view == devcode.db.explorer && viewItem =~ /^conn/",
          "group": "inline@0"
        },
        {
          "command": "devcode.db.newSql",
          "when": "view == devcode.db.explorer && viewItem =~ /^conn/",
          "group": "1@0"
        },
        {
          "command": "devcode.db.setActive",
          "when": "view == devcode.db.explorer && viewItem =~ /^conn/",
          "group": "1@1"
        },
        {
          "command": "devcode.db.disconnect",
          "when": "view == devcode.db.explorer && viewItem == conn-open",
          "group": "2@0"
        },
        {
          "command": "devcode.db.remove",
          "when": "view == devcode.db.explorer && viewItem =~ /^conn/",
          "group": "2@1"
        },
        {
          "command": "devcode.db.openTable",
          "when": "view == devcode.db.explorer && viewItem == table",
          "group": "inline@0"
        },
        {
          "command": "devcode.db.tableInfo",
          "when": "view == devcode.db.explorer && viewItem == table",
          "group": "inline@1"
        },
        {
          "command": "devcode.db.openTable",
          "when": "view == devcode.db.explorer && viewItem == table",
          "group": "1@0"
        },
        {
          "command": "devcode.db.tableInfo",
          "when": "view == devcode.db.explorer && viewItem == table",
          "group": "1@1"
        },
        {
          "command": "devcode.db.selectTable",
          "when": "view == devcode.db.explorer && viewItem == table",
          "group": "1@2"
        },
        {
          "command": "devcode.db.showSource",
          "when": "view == devcode.db.explorer && viewItem == table",
          "group": "1@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "devcode.run",
        "key": "f5",
        "when": "editorLangId != sql"
      },
      {
        "command": "devcode.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId != sql"
      },
      {
        "command": "devcode.db.runStatement",
        "key": "ctrl+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "devcode.db.runAll",
        "key": "alt+x",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "devcode.db.runAll",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "devcode.prototype.groupKey",
        "key": "ctrl+g",
        "mac": "cmd+g",
        "when": "activeCustomEditorId == devcode.prototype && focusedView == ''"
      },
      {
        "command": "devcode.prototype.ungroupKey",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "activeCustomEditorId == devcode.prototype && focusedView == ''"
      }
    ],
    "configuration": {
      "title": "DEV CODE",
      "properties": {
        "devcode.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Comando do Python usado pelo botão Executar (padrão: python / python3)."
        },
        "devcode.projectType": {
          "type": "string",
          "enum": [
            "python",
            "colab",
            "prototipo",
            "teste",
            "html",
            "react",
            "expo"
          ],
          "description": "Tipo do projeto (definido pelo assistente de Novo Projeto)."
        },
        "devcode.liveServer.browser": {
          "type": "string",
          "enum": [
            "interno",
            "externo"
          ],
          "default": "interno",
          "enumDescriptions": [
            "Navegador embutido, ao lado do código",
            "Navegador padrão do sistema"
          ],
          "description": "Onde abrir o Live Server."
        },
        "devcode.startupChooser": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar o menu de projetos ao abrir a IDE sem projeto."
        },
        "devcode.expo.target": {
          "type": "string",
          "enum": [
            "perguntar",
            "android",
            "celular"
          ],
          "default": "perguntar",
          "enumDescriptions": [
            "Usa o emulador se estiver instalado; senão, pergunta",
            "Sempre o emulador Android",
            "Sempre o celular (Expo Go / QR Code)"
          ],
          "description": "Onde abrir os apps React Native (Expo) ao executar."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "[$(home) Tela Inicial](command:devcode.startPage)\nCrie um projeto (Python, HTML, React, React Native) ou baixe o seu do GitHub.",
        "when": "workbenchState == empty"
      },
      {
        "view": "devcode.db.explorer",
        "contents": "Conecte-se a um banco para ver as tabelas, os registros, as chaves e as triggers, e executar SQL.\n[$(add) Nova conexão](command:devcode.db.add)\nFirebird (arquivo .fdb), MySQL ou PostgreSQL."
      }
    ],
    "notebookRenderer": [
      {
        "id": "devcode-input",
        "displayName": "DEV CODE: entrada de dados (input)",
        "entrypoint": "./renderer/inputRenderer.js",
        "mimeTypes": [
          "application/x-devcode-input"
        ],
        "requiresMessaging": "always"
      }
    ],
    "customEditors": [
      {
        "viewType": "devcode.prototype",
        "displayName": "DEV CODE: Protótipo",
        "selector": [
          {
            "filenamePattern": "*.devproto"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "devcode.test",
        "displayName": "DEV CODE: Testes de Sites",
        "selector": [
          {
            "filenamePattern": "*.devtest"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devcode-db",
          "title": "Banco de Dados",
          "icon": "media/database.svg"
        },
        {
          "id": "devcode-github",
          "title": "GitHub",
          "icon": "media/github.svg"
        }
      ]
    },
    "views": {
      "devcode-github": [
        {
          "type": "webview",
          "id": "devcode.github.panel",
          "name": "GitHub",
          "icon": "media/github.svg"
        }
      ],
      "devcode-db": [
        {
          "id": "devcode.db.explorer",
          "name": "Conexões",
          "icon": "media/database.svg"
        }
      ]
    }
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "node-firebird": "^2.21.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.65.1"
  }
}
